extends SceneTree

const State = preload("res://scripts/intro_state.gd")
var failures: int = 0


func check(condition: bool, description: String) -> void:
	if not condition:
		failures += 1
		push_error(description)


func _initialize() -> void:
	var state = State.new()
	check(state.phase == State.Phase.ARRIVAL and state.carried == -1, "Route starts in car without a carried parcel")
	check(not state.trunk_open and state.delivered.is_empty(), "New route starts with closed trunk and no deliveries")
	check(state.phone_messages().contains("Clara") and not state.phone_messages().contains("Número desconocido"), "Phone has neighbor requests before mysterious delivery")
	state.take_order(0)
	state.toggle_trunk()
	state.take_last_package()
	state.arrive_at_house()
	state.enter_house()
	check(state.phase == State.Phase.ARRIVAL and state.carried == -1 and not state.trunk_open, "Player cannot skip arrival, neighbors or final parcel")

	state.arrive_at_building()
	check(state.phase == State.Phase.DELIVERIES, "Parking unlocks neighbor deliveries")
	state.take_order(0)
	check(state.carried == -1, "Closed trunk prevents pickup")
	state.toggle_trunk()
	state.take_order(-1)
	state.take_order(99)
	state.deliver("101")
	check(state.carried == -1 and state.delivered.is_empty(), "Invalid pickups and empty hands cannot make progress")
	state.take_order(0)
	state.take_order(1)
	check(state.carried == 0 and state.carrying_text().contains("101"), "Only one parcel can be carried and label identifies its door")
	state.deliver("103")
	check(state.carried == 0 and state.delivered.is_empty(), "Wrong door preserves the parcel")
	state.toggle_trunk()
	state.return_order()
	check(state.carried == 0, "Returning needs open trunk")
	state.toggle_trunk()
	state.return_order()
	check(state.carried == -1 and state.delivered.is_empty(), "Returning does not count as delivery")

	for index in [2, 0, 1]:
		state.take_last_package()
		state.arrive_at_house()
		check(state.phase == State.Phase.DELIVERIES and state.carried == -1, "All neighbors required before final route")
		state.take_order(index)
		var reply: String = state.deliver(str(State.ORDERS[index]["door"]))
		check(reply == str(State.ORDERS[index]["reply"]), "Correct door returns its neighbor conversation")
		check(state.delivered.has(index) and state.carried == -1, "Correct door consumes parcel once")
		state.take_order(index)
		check(state.carried == -1, "Delivered parcels cannot be collected twice")

	check(state.is_complete() and state.delivered.size() == 3 and state.phase == State.Phase.LAST_PACKAGE, "Any delivery order unlocks exactly one final package")
	check(state.phone_messages().contains("Número desconocido"), "Unknown sender appears after neighbor deliveries")
	state.enter_house()
	state.arrive_at_house()
	check(state.phase == State.Phase.LAST_PACKAGE, "Final destination requires actually collecting final parcel")
	state.toggle_trunk()
	state.take_last_package()
	check(state.carried == -1, "Final parcel is also gated by closed trunk")
	state.toggle_trunk()
	state.take_last_package()
	check(state.phase == State.Phase.TO_HOUSE and state.carried == State.LAST_PACKAGE, "Taking last package unlocks drive to abandoned house")
	state.take_last_package()
	state.deliver("101")
	check(state.carried == State.LAST_PACKAGE and state.delivered.size() == 3, "Final parcel cannot be duplicated or delivered to a neighbor")
	state.return_order()
	state.arrive_at_house()
	check(state.carried == -1 and state.phase == State.Phase.TO_HOUSE, "Returned final parcel blocks arrival without stranding route")
	check(state.objective().contains("Recoge"), "Objective directs player to recollect a returned final parcel")
	state.take_last_package()
	state.arrive_at_house()
	check(state.phase == State.Phase.HOUSE and state.carried == State.LAST_PACKAGE and not state.trunk_open, "Arrival preserves final parcel and closes trunk")
	state.toggle_trunk()
	state.return_order()
	check(state.carried == State.LAST_PACKAGE, "Final house cannot lose required parcel")
	state.enter_house()
	check(state.phase == State.Phase.CAPTURED and state.carried == -1 and not state.trunk_open, "Entering house finishes capture sequence and hands over parcel")
	state.arrive_at_building()
	state.take_last_package()
	state.take_order(0)
	state.toggle_trunk()
	check(state.phase == State.Phase.CAPTURED and state.carried == -1 and not state.trunk_open, "Completed intro cannot be rewound through interaction methods")
	check(not state.objective().is_empty() and not state.carrying_text().is_empty(), "UI has objective and carrying status at intro end")
	print("Intro route rules: %d failures" % failures)
	quit(1 if failures else 0)
